# Leave this empty in the all-in-one Docker deployment.
# Murmur will talk to the bundled Open WebUI at http://127.0.0.1:$PORT.
# Set it only when Murmur connects to an external Open WebUI instance.
OPENWEBUI_BASE_URL=

# Optional. If omitted, Murmur signs into Open WebUI with
# OPENWEBUI_LOGIN_EMAIL/PASSWORD or WEBUI_ADMIN_EMAIL/PASSWORD and uses a JWT.
OPENWEBUI_API_KEY=
OPENWEBUI_LOGIN_EMAIL=
OPENWEBUI_LOGIN_PASSWORD=
OPENWEBUI_MODEL=your-model-name
# Optional aliases for Messenger model switching.
# Format: alias=model-id,alias2=model-id
OPENWEBUI_MODEL_ALIASES=free=your-model-name
# Warms auth, model list, and a tiny chat completion before Messenger starts listening.
OPENWEBUI_WARMUP=true
OPENWEBUI_WARMUP_CHAT=true

FB_COOKIES_PATH=cookies.json
# Render-friendly alternative to mounting cookies.json:
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.json"))
FB_COOKIES_JSON_B64=
# Optional: set this to the exact browser user-agent from the session that exported cookies.
FB_USER_AGENT=
# Optional: HTTP/SOCKS proxy for Facebook requests, if your host IP is blocked or challenged.
FB_PROXY=
# Facebook web request timeout for login/session extraction and uploads.
FB_HTTP_TIMEOUT_SECONDS=120
# Optional: HTTP/SOCKS proxy used only for Messenger attachment upload POSTs.
FB_UPLOAD_PROXY=
# Optional: override proxy for Messenger MQTT websocket. Defaults to FB_PROXY.
FB_MQTT_PROXY=
# Restart Murmur if the Messenger realtime listener silently dies.
FB_MQTT_WATCHDOG_SECONDS=15
# Retry Messenger attachment uploads when Facebook's upload host times out.
FB_UPLOAD_RETRIES=3
# Comma-separated web Messenger upload endpoints to try in order.
FB_UPLOAD_ENDPOINTS=https://upload.facebook.com/ajax/mercury/upload.php,https://upload.messenger.com/ajax/mercury/upload.php

# Safer default: Murmur only answers messages that start with /ai.
BOT_PREFIX=/ai
RESPOND_ONLY_ON_PREFIX=true
# Allows follow-up messages when a user replies directly to the bot.
RESPOND_TO_BOT_REPLIES=true

# Optional: restrict Murmur to specific Messenger thread IDs, comma-separated.
# Leave empty while testing, then lock it down.
ALLOWED_THREAD_IDS=

MAX_HISTORY_MESSAGES=12
MAX_REPLY_CHARS=1800
REQUEST_TIMEOUT_SECONDS=120

SYSTEM_PROMPT=You are a helpful AI assistant inside a Messenger group chat. Be concise unless asked for detail.

# All-in-one Open WebUI deployment settings.
WEBUI_SECRET_KEY=change-this-to-a-long-random-secret
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=change-this-admin-password
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
ENABLE_OLLAMA_API=false
ENABLE_BASE_MODELS_CACHE=true
ENV=prod
USER_AGENT=Murmur/0.1

# Neon/Postgres persistence. Run `CREATE EXTENSION IF NOT EXISTS vector;` in Neon first.
# Open WebUI v0.9 has mixed psycopg2/asyncpg Postgres SSL handling.
# Keep SSL query params out of the URL and use PGSSLMODE instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
PGSSLMODE=require
VECTOR_DB=pgvector
PGVECTOR_DB_URL=postgresql://USER:PASSWORD@HOST/DB
PGVECTOR_CREATE_EXTENSION=false

# Configure an OpenAI-compatible provider for the bundled Open WebUI.
# Murmur does not call this provider directly.
# Examples: OpenRouter, Groq, DeepSeek, OpenAI-compatible gateways, etc.
OPENAI_API_BASE_URL=https://your-provider.example.com/v1
OPENAI_API_KEY=your-provider-api-key

# Optional image generation bridge.
# With Cloudflare Workers AI credentials, startup exposes a local OpenAI-compatible
# image endpoint for Open WebUI and enables /ai image prompts in Messenger.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_PROXY_API_KEY=
IMAGE_PROXY_BASE_PATH=/murmur-image-openai/v1
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE=openai
IMAGE_PROVIDER_LABEL=Cloudflare
IMAGE_GENERATION_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_SIZE=1024x1024
IMAGE_STEPS=4
