# murmur whatsapp pipeline config
# copy this to .env and fill in real values
# .env is gitignored — never commit it

# hugging face auth
# either put the raw token here, or put your HF email and the script will
# load the token from %APPDATA%\mainframe\accounts\hf\<email>\token
HF_TOKEN=
HF_EMAIL=fahadbinhussain001@gmail.com

# murmur space
MURMUR_HF_SPACE_URL=https://fahadbinhussain-murmur.hf.space

# webhook secret shared with the HF space
WEBHOOK_SECRET=murmur-wa-2026

# local proxy settings
PROXY_PORT=7870
POLL_SECONDS=5

# wacli paths (auto-detected if left empty)
WACLI_STORE_PATH=
WACLI_BIN=C:\Users\Admin\go\bin\wacli.exe

# optional: proxy script path, auto-detected if left empty
MURMUR_PROXY_SCRIPT=
