# murmur whatsapp pipeline config
# copy this to .env and fill in real values
# .env is gitignored — never commit it

# hugging face auth
# either put the raw token here, or put your HF email and the script will
# load the token from %APPDATA%\mainframe\accounts\hf\<email>\token
HF_TOKEN=
HF_EMAIL=

# murmur space
MURMUR_HF_SPACE_URL=

# neon: murmur project DSN (read by the Go bridge + scripts/upload-session.ps1)
DATABASE_URL=

# facebook cookie refresher - cookies are read live from the real Edge session
# (browser-use skill, http://127.0.0.1:9222); no cookie vault to maintain
MURMUR_REFRESH_FB_URL=https://www.messenger.com

# webhook secret shared with the HF space
WEBHOOK_SECRET=

# local proxy settings
PROXY_PORT=7870
POLL_SECONDS=5

# wacli paths (auto-detected if left empty)
WACLI_STORE_PATH=
WACLI_BIN=

# optional: proxy script path, auto-detected if left empty
MURMUR_PROXY_SCRIPT=

# gamebot (free games rss → messenger)
# GitHub Actions polls LootScraper RSS and POSTs to this URL
MURMUR_WEBHOOK_URL=
