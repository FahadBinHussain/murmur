OPENWEBUI_BASE_URL=https://your-open-webui.onrender.com
OPENWEBUI_API_KEY=sk-your-open-webui-api-key
OPENWEBUI_MODEL=your-model-name

FB_COOKIES_PATH=cookies.json

# Safer default: Murmur only answers messages that start with /ai.
BOT_PREFIX=/ai
RESPOND_ONLY_ON_PREFIX=true

# Optional: restrict Murmur to specific Messenger thread IDs, comma-separated.
# Leave empty while testing, then lock it down.
ALLOWED_THREAD_IDS=

MAX_HISTORY_MESSAGES=12
MAX_REPLY_CHARS=1800
REQUEST_TIMEOUT_SECONDS=120

SYSTEM_PROMPT=You are a helpful AI assistant inside a Messenger group chat. Be concise unless asked for detail.
