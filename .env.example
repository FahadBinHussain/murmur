# Murmur bridge
BOT_PREFIX=/ai
RESPOND_ONLY_ON_PREFIX=true
RESPOND_TO_BOT_REPLIES=true
ALLOWED_THREAD_IDS=
MAX_HISTORY_MESSAGES=12
MAX_REPLY_CHARS=1800
REQUEST_TIMEOUT_SECONDS=120
SYSTEM_PROMPT=You are a helpful AI assistant inside a Messenger group chat. Be concise unless asked for detail.
MURMUR_RESTART_SECONDS=60
MURMUR_PID_FILE=/tmp/murmur.pid
MURMUR_RESTART_NOW_FILE=/tmp/murmur-restart-now
MURMUR_ADMIN_CONSOLE=true
MURMUR_ADMIN_PATH=/murmur-admin
MURMUR_ADMIN_USERNAME=
MURMUR_ADMIN_PASSWORD=
MURMUR_THREAD_REGISTRY_PATH=/tmp/murmur-threads.json
MURMUR_THREAD_ALLOWLIST_PATH=/tmp/murmur-thread-allowlist.json
MURMUR_THREAD_FETCH_LIMIT=100
MURMUR_PERSIST_COOKIES_TO_DB=true
MURMUR_STATE_DATABASE_URL=
MURMUR_STATE_TABLE=murmur_runtime_state
MURMUR_COOKIE_STATE_ENCRYPT=true
MURMUR_COOKIE_STATE_SECRET=

# Facebook / Messenger
FB_COOKIES_PATH=cookies.json
FB_COOKIES_JSON_B64=
FB_USER_AGENT=
FB_PROXY=
FB_UPLOAD_PROXY=
FB_MQTT_PROXY=
FB_HTTP_TIMEOUT_SECONDS=120
FB_MQTT_WATCHDOG_SECONDS=15
FB_UPLOAD_RETRIES=3
FB_UPLOAD_ENDPOINTS=https://upload.facebook.com/ajax/mercury/upload.php,https://upload.messenger.com/ajax/mercury/upload.php
FB_LOG_NAMES=true
FB_LOG_NAMES_KEEP_IDS=true
FB_LOG_NAME_CACHE_PATH=/tmp/murmur-fb-names.json

# Open WebUI bridge auth
# Leave OPENWEBUI_BASE_URL empty in the all-in-one Docker/HF deployment.
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_LOGIN_EMAIL=
OPENWEBUI_LOGIN_PASSWORD=
OPENWEBUI_MODEL=your-model-name
OPENWEBUI_MODEL_ALIASES=free=your-model-name
OPENWEBUI_WARMUP=true
OPENWEBUI_WARMUP_CHAT=true
OPENWEBUI_ACCESS_LOG=false

# Bundled Open WebUI app
WEBUI_SECRET_KEY=change-this-to-a-long-random-secret
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=change-this-admin-password
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
ENABLE_OLLAMA_API=false
ENABLE_BASE_MODELS_CACHE=true
ENV=prod
USER_AGENT=Murmur/0.1
WEBUI_URL=
CORS_ALLOW_ORIGIN=

# Provider connection sync
# Murmur stays bridge-only: these keys are synced into Open WebUI Connections.
# Add future families the same way, for example:
# OPENWEBUI_PROVIDER_FAMILIES=openrouter,cloudflare,gemini,mistral
# GEMINI_API_BASE_URL=https://your-openai-compatible-gemini-gateway/v1
# GEMINI_API_KEY_1=...
OPENWEBUI_PROVIDER_SYNC=true
OPENWEBUI_PROVIDER_FAMILIES=openrouter

# Provider: OpenRouter
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# Provider: Cloudflare Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=
CLOUDFLARE_API_BASE_URL=
CLOUDFLARE_MODEL_IDS=
CLOUDFLARE_HIDE_EXPERIMENTAL_MODELS=true

# Optional single OpenAI-compatible fallback connection.
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# Database persistence
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
PGSSLMODE=require
VECTOR_DB=pgvector
PGVECTOR_DB_URL=postgresql://USER:PASSWORD@HOST/DB
PGVECTOR_CREATE_EXTENSION=false

# Optional image generation bridge
IMAGE_PROXY_API_KEY=
IMAGE_PROXY_BASE_PATH=/murmur-image-openai/v1
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE=openai
IMAGE_GENERATION_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_SIZE=1024x1024
IMAGE_STEPS=4
