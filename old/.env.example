# Murmur bridge
BOT_PREFIX=/ai
RESPOND_ONLY_ON_PREFIX=true
RESPOND_TO_BOT_REPLIES=true
ALLOWED_THREAD_IDS=
MAX_HISTORY_MESSAGES=12
MAX_REPLY_CHARS=1800
REQUEST_TIMEOUT_SECONDS=120
SYSTEM_PROMPT=You are a helpful AI assistant inside a Messenger group chat. Be concise unless asked for detail.
MURMUR_RESTART_SECONDS=10
MURMUR_PID_FILE=/tmp/murmur.pid
MURMUR_RESTART_NOW_FILE=/tmp/murmur-restart-now
MURMUR_FACEBOOK_COOKIE_EXPIRED_EXIT_CODE=42
MURMUR_ADMIN_CONSOLE=true
MURMUR_ADMIN_PATH=/murmur-admin
MURMUR_ADMIN_USERNAME=
MURMUR_ADMIN_PASSWORD=
MURMUR_ADMIN_SESSION_SECONDS=86400
MURMUR_ADMIN_SESSION_SECRET=
MURMUR_ADMIN_COOKIE_SECURE=
MURMUR_ADMIN_BASIC_AUTH=false
MURMUR_THREAD_REGISTRY_PATH=/tmp/murmur-threads.json
MURMUR_THREAD_ALLOWLIST_PATH=/tmp/murmur-thread-allowlist.json
MURMUR_THREAD_FETCH_LIMIT=100
MURMUR_PERSIST_COOKIES_TO_DB=true
MURMUR_PERSIST_THREAD_MODELS_TO_DB=true
MURMUR_STATE_DATABASE_URL=
MURMUR_STATE_TABLE=murmur_runtime_state
MURMUR_COOKIE_STATE_ENCRYPT=true
MURMUR_COOKIE_STATE_SECRET=
MURMUR_LOAD_PROXY_STATE=true

# Optional Daily BNP article notifications
BNP_MESSENGER_OUTBOX_URL=https://dailybnp.com/api/internal/bnp-messenger-outbox
BNP_MESSENGER_OUTBOX_TOKEN=
BNP_MESSENGER_THREAD_ID=984803114200952
BNP_MESSENGER_POLL_SECONDS=30
BNP_MESSENGER_CLAIM_LIMIT=2
BNP_MESSENGER_REQUEST_TIMEOUT_SECONDS=30

# Generic Codex/local automation notifications
MURMUR_AUTOMATION_NOTIFICATIONS=true
MURMUR_AUTOMATION_NOTIFICATION_TOKEN=
MURMUR_AUTOMATION_NOTIFICATION_PATH=/api/automation/notifications
MURMUR_AUTOMATION_NOTIFICATION_DEFAULT_THREAD_ID=2637078310061988
MURMUR_AUTOMATION_NOTIFICATION_POLL_SECONDS=10
MURMUR_AUTOMATION_NOTIFICATION_CLAIM_LIMIT=5
MURMUR_AUTOMATION_NOTIFICATION_MAX_ATTEMPTS=12
MURMUR_AUTOMATION_NOTIFICATION_MAX_MESSAGE_CHARS=3500
MURMUR_AUTOMATION_NOTIFICATION_QUEUE_PATH=/tmp/murmur-automation-notifications.json

# Facebook / Messenger
FB_COOKIES_PATH=cookies.json
FB_COOKIES_JSON_B64=
FB_USER_AGENT=
FB_NETWORK_POLICY=auto
FB_PROXY=
FB_UPLOAD_PROXY=
FB_MQTT_PROXY=direct
WEBSHARE_API_KEY=
WEBSHARE_API_BASE_URL=https://proxy.webshare.io/api/v2
WEBSHARE_PROXY_MODE=backbone
WEBSHARE_PROXY_PAGE_SIZE=50
WEBSHARE_PROXY_COUNTRIES=
WEBSHARE_BACKBONE_HOST=p.webshare.io
WEBSHARE_BACKBONE_PORT=80
WEBSHARE_PROXY_TEST_URL=https://www.facebook.com/
WEBSHARE_PROXY_TEST_TIMEOUT_SECONDS=20
WEBSHARE_PROXY_TEST_CONCURRENCY=10
WEBSHARE_KEEP_LAST_ON_ROTATION_FAILURE=true
WEBSHARE_API_TIMEOUT_SECONDS=20
FB_HTTP_TIMEOUT_SECONDS=120
FBCHAT_BOOTSTRAP_RETRIES=3
FBCHAT_BOOTSTRAP_RETRY_DELAY_SECONDS=2
FBCHAT_BOOTSTRAP_TIMEOUT_SECONDS=45
FBCHAT_MQTT_APP_ID=219994525426954
FBCHAT_MQTT_REGION=
FB_MQTT_WATCHDOG_SECONDS=15
FB_UPLOAD_RETRIES=3
FB_UPLOAD_ENDPOINTS=https://upload.facebook.com/ajax/mercury/upload.php,https://upload.messenger.com/ajax/mercury/upload.php
FB_LOG_NAMES=true
FB_LOG_NAMES_KEEP_IDS=true
FB_LOG_NAME_CACHE_PATH=/tmp/murmur-fb-names.json

# Browser-assisted Facebook cookie refresh
# Used locally by scripts/facebook_login_refresh.py and by hosted auto-refresh.
FB_LOGIN_EMAIL=
FB_LOGIN_PHONE=
FB_LOGIN_PASSWORD=
FB_LOGIN_TOTP_SECRET=
FB_LOGIN_URL=https://m.facebook.com/login
FB_LOGIN_BROWSER_ENGINE=cloakbrowser
FB_LOGIN_PROFILE_DIR=.murmur-facebook-profile
FB_LOGIN_EXPORT_PATH=cookies.json
FB_LOGIN_PROFILE_VAULT_ENABLED=true
FB_LOGIN_PROFILE_VAULT_RESTORE=true
FB_LOGIN_PROFILE_VAULT_OVERWRITE=false
FB_LOGIN_PROFILE_PERSIST_DB=true
FB_LOGIN_PROFILE_BOOTSTRAP_COOKIES=true
FB_LOGIN_PROFILE_BOOTSTRAP_DB_COOKIES=true
FB_LOGIN_PROFILE_VAULT_MAX_BYTES=209715200
FB_LOGIN_HEADLESS=false
FB_LOGIN_TIMEOUT_SECONDS=300
FB_LOGIN_NAV_TIMEOUT_SECONDS=120
FB_LOGIN_VERIFY=true
FB_LOGIN_CLEAR_ON_VERIFY_FAILURE=false
FB_LOGIN_FORCE_FRESH_FALLBACK=true
FB_LOGIN_PERSIST_DB=true
FB_LOGIN_BACKUP_EXISTING=false
FB_LOGIN_PROXY=direct
FB_LOGIN_DIRECT_FALLBACK_ON_PROXY_FAILURE=true
FB_LOGIN_VERIFY_PROXY=direct
FB_LOGIN_USER_AGENT=
FB_LOGIN_AUTO_REFRESH=true
FB_LOGIN_AUTO_REFRESH_COOLDOWN_SECONDS=900
FB_LOGIN_AUTO_REFRESH_STAMP=/tmp/murmur-facebook-login-refresh-last

# AI backend. Default is LiteLLM, but OpenWebUI support is kept.
MURMUR_AI_BACKEND=litellm

# LiteLLM / OpenAI-compatible gateway
# LITELLM_BASE_URL may include or omit the trailing /v1.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_MODEL_ALIASES=
LITELLM_PREFERRED_CHAT_MODELS=
LITELLM_WARMUP=true
LITELLM_WARMUP_CHAT=true

# Optional OpenWebUI backend
# Use MURMUR_AI_BACKEND=openwebui to route chat/image/model calls here.
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_LOGIN_EMAIL=
OPENWEBUI_LOGIN_PASSWORD=
OPENWEBUI_MODEL=
OPENWEBUI_MODEL_ALIASES=
OPENWEBUI_PREFERRED_CHAT_MODELS=
OPENWEBUI_WARMUP=true
OPENWEBUI_WARMUP_CHAT=true

# Optional Lobe chat mirror
# Mirrors successful Murmur chat exchanges into Lobe's Postgres database.
LOBE_SYNC_ENABLED=false
LOBE_DATABASE_URL=
LOBE_SYNC_USER_EMAIL=
LOBE_SYNC_USER_ID=
LOBE_SYNC_AGENT_TITLE=Murmur
LOBE_SYNC_AGENT_SLUG=murmur
LOBE_SYNC_SESSION_TITLE=Murmur
LOBE_SYNC_SESSION_SLUG=murmur
LOBE_SYNC_TOPIC_PREFIX=Messenger

# Image generation through the selected backend
IMAGE_GENERATION_MODEL=
IMAGE_SIZE=1024x1024
IMAGE_STEPS=4

# Optional local image adapter. Leave disabled when LiteLLM already has image routes.
MURMUR_ENABLE_IMAGE_PROXY=false
IMAGE_PROXY_API_KEY=
IMAGE_PROXY_BASE_PATH=/murmur-image-openai/v1
