%% Murmur current runtime flow
%% Keep this file in sync with murmur/app.py, murmur/proxy.py,
%% murmur/runtime_state.py, scripts/start-hf.sh, and scripts/facebook_login_refresh.py.

flowchart TD
    A["HF Space starts"] --> B["Restore browser profile from DB"]
    B --> C["Write Facebook cookies from DB"]
    C --> C1{"Facebook network policy"}
    C1 -->|direct| D["Start public bridge proxy"]
    C1 -->|auto without Webshare key| D
    C1 -->|auto or webshare with key| C2["Test stored Facebook proxy"]
    C2 -->|works| D
    C2 -->|fails or empty| C3["Fetch valid Webshare proxies"]
    C3 --> C4["Test candidates against Facebook"]
    C4 -->|working proxy| C5["Persist proxy state to DB"]
    C5 --> D
    C4 -->|none work| C6["Log exact proxy failure"]
    C6 --> C7["Supervisor restarts Murmur"]
    C7 --> H

    D --> D1["Root URL shows Murmur status/admin"]
    D --> D2["Optional proxy routes forward to configured target"]
    D --> G["Warm selected AI backend if enabled"]
    G --> H["Start Murmur listener"]

    H --> I["fbchat loads cookies"]
    I --> J["Run cookie preflight"]

    J -->|valid| K["Login verified"]
    K --> L["Connect Messenger realtime"]
    L --> M["Murmur online"]

    J -->|invalid| N["Exit with cookie expired code"]
    N --> O["Supervisor checks refresh cooldown"]
    O -->|cooldown active| P["Restart after short delay"]
    P --> H
    O -->|refresh allowed| Q["Run Facebook login refresh"]
    Q --> R["Restore trusted browser profile"]
    R --> S["Launch browser"]
    S --> T["Use login and authenticator code"]
    T --> U["Export new Facebook cookies"]
    U --> V["Verify cookies with fbchat"]
    V -->|verified| W["Save cookies to DB"]
    W --> X["Save browser profile to DB"]
    X --> Y["Restart Murmur"]
    Y --> H
    V -->|blocked| Z["Log exact failure"]
    Z --> AA["Needs human action"]

    M --> AB["Receive Messenger message"]
    AB --> AC{"Command type"}

    AC -->|chat| AD["Build thread memory"]
    AD --> AE["Call selected backend chat endpoint"]
    AE --> AEL["Mirror successful exchange to Lobe when enabled"]
    AEL --> AF["Split long reply"]
    AF --> AG["Send Messenger reply"]

    AC -->|image| AH["Call selected backend image endpoint"]
    AH --> AI["Download or decode returned image"]
    AI --> AJ["Upload image to Messenger"]
    AJ --> AG

    AC -->|model command| AK["List or set model from backend model endpoints"]
    AK --> AL["Save thread model choice"]
    AL --> AG

    AC -->|admin help status| AM["Return command or status text"]
    AM --> AG

    AN["Admin console"] --> AO["Upload cookies"]
    AO --> AP["Validate and save cookies"]
    AP --> AQ["Persist cookies to DB"]
    AQ --> AR["Restart Murmur listener"]
    AR --> H

    AN --> AS["Manage allowed threads"]
    AS --> AT["Persist thread allowlist"]

    AN --> AU["Manage optional Facebook proxies"]
    AU --> AV["Persist proxy state to DB"]
    AV --> AR

    subgraph FacebookProxyState["Facebook proxy state"]
        BA["FB_PROXY (direct allowed)"]
        BB["FB_UPLOAD_PROXY"]
        BC["FB_MQTT_PROXY (direct allowed)"]
        BD["FB_LOGIN_PROXY"]
        BE["Webshare manager can refresh stored proxy"]
    end

    BE --> H
    BE --> Q
